<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 masks the icon to a 192dp circle within a 288dp canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="160dp" android:height="160dp"
        android:gravity="center" android:drawable="@drawable/floosy_logo" />
</layer-list>

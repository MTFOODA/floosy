<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch background — matches the Flutter Floosy splash screen
     for a seamless native → Flutter transition. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color matching the Flutter splash scaffold (light theme). -->
    <item android:drawable="@color/floosy_background" />

    <!-- Floosy logo centered, never stretched. -->
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/floosy_logo" />
</layer-list>
